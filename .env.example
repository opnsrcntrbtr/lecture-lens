# Copy to .env and edit. .env is ignored by git and blocked by the content guard.

# ---- local LLM (any OpenAI-compatible server on this machine) ----
OMLX_BASE_URL=http://127.0.0.1:8001/v1
OMLX_MODEL=<generator model id>
# Eval judge: a different model from the generator; swapped in by the eval runner
OMLX_JUDGE_MODEL=<judge model id>
# OMLX_API_KEY=<only if your server needs one>
# Vision model for slides (blank = on-screen text only)
OMLX_VL_MODEL=<vision-capable model id>
OMLX_VL_THINK=false

# ---- screenpipe (install it yourself; see docs: Getting started) ----
SCREENPIPE_URL=http://localhost:3030
SP_BIN=$HOME/screenpipe/target/release/screenpipe

# ---- capture modes ----
#  portal = self-paced study in the browser, restricted to allowed-domains.txt
#  live   = a live class in a meeting app
SP_PORTAL_APPS="Google Chrome"
SP_LIVE_APPS="zoom.us,Zoom"
# Browser windows also captured in live mode: "<app>::<title contains>"
SP_LIVE_BROWSER_TITLES=""
SP_AUTO_SWITCH=true
SP_LIVE_COOLDOWN_MIN=2
SP_URL_ALLOW=
# Anything with these in the app or window title is never recorded
SP_IGNORE="1Password,Keychain,Messages,WhatsApp,Mail,Private,Incognito"
SP_AUDIO_ENGINE=whisper-large-v3-turbo-quantized

# ---- your course ----
# Host of your course portal (lecture sessions are found by this)
STUDY_LECTURE_SITE=learn.example.edu
# The portal's name as it appears in window titles (optional)
STUDY_PORTAL_NAME=
STUDY_COURSE_NAME="My course"
# Pages whose video is copy-protected: screen capture pauses there, audio continues.
# Comma-separated host or host/path-prefix.
SP_DRM_URLS="learn.example.edu/player"

# ---- outputs ----
STUDY_LECTURE_DIR=$HOME/lecture-lens/lectures
STUDY_NOTES_DIR=$HOME/lecture-lens/notes
STUDY_VAULT=$HOME/vaults/my-course
STUDY_VAULT_SUBDIR=Lectures
STUDY_CTX_CHARS=60000
STUDY_AUDIO_DEVICE=auto
STUDY_VL_MAX_EDGE=1600
SCREENPIPE_AUDIO_TAP_APPS="Google Chrome"

# ---- frame sampling ----
SP_VISUAL_CHECK_MS=2000
SP_VISUAL_CHANGE_THRESHOLD=0.12
SP_MIN_CAPTURE_MS=3000
SP_IDLE_CAPTURE_MS=20000
